    {
      "name": "1 Alta de equipo",
      "item": [
        {
          "name": "Crear equipo (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigo\", \"PM-\" + Date.now().toString(36).toUpperCase() + \"A\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Equipo creado DISPONIBLE\", () => {",
                  "    pm.expect(json.id).to.be.a(\"number\");",
                  "    pm.expect(json.estado).to.eql(\"DISPONIBLE\");",
                  "    pm.expect(json.codigoPatrimonial).to.eql(pm.collectionVariables.get(\"codigo\"));",
                  "});",
                  "pm.collectionVariables.set(\"equipoId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoPatrimonial\": \"{{codigo}}\",\n  \"nombre\": \"Laptop Postman\",\n  \"tipo\": \"Laptop\"\n}",
              "options": {
