    {
      "name": "4 Registro de préstamo",
      "item": [
        {
          "name": "Registrar préstamo (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const iso = (d) => d.toISOString().slice(0, 10);",
                  "const hoy = new Date();",
                  "pm.collectionVariables.set(\"fechaHoy\", iso(hoy));",
                  "pm.collectionVariables.set(\"fechaPrevista\", iso(new Date(hoy.getTime() + 7 * 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Préstamo ACTIVO sin devolución real\", () => {",
                  "    pm.expect(json.estado).to.eql(\"ACTIVO\");",
                  "    pm.expect(json.fechaDevolucionReal).to.be.null;",
                  "});",
                  "pm.collectionVariables.set(\"prestamoId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": {{equipoId}},\n  \"nombreSolicitante\": \"Estudiante Postman\",\n  \"fechaPrestamo\": \"{{fechaHoy}}\",\n  \"fechaPrevistaDevolucion\": \"{{fechaPrevista}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos"
              ]
            }
          }
        },
